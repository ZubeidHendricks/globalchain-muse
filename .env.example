# Meta Model API (https://dev.meta.ai/api-keys/). Leave empty to run the offline mock engine.
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
# Optional per-task overrides of MUSE_MODEL, e.g. VERIFY_MODEL=muse-wonder-1.0 to A/B test verification.
VERIFY_MODEL=
SELLER_MODEL=
AGENT_MODEL=
SAM_MODEL=sam-3.1
REASONING_EFFORT=medium

# Hedera operator for anchoring. Leave empty to issue records without anchoring.
HEDERA_NETWORK=testnet
OPERATOR_ID=
OPERATOR_KEY=
# Reuse an existing topic; if empty, one is created on first anchor (check the logs for its id).
HEDERA_TOPIC_ID=
# Origin registrations also mint an HTS NFT certificate. Reuse a collection, or leave empty to create one.
MINT_CERTIFICATES=true
HEDERA_NFT_TOKEN_ID=

DATABASE_PATH=globalchain.db
# Used in passport, origin and QR links and to decide MCP host checking (localhost keeps DNS-rebinding protection on).
PUBLIC_BASE_URL=http://localhost:8000
USD_ZAR_RATE=18.0
HEDERA_PAYMENT_TOKEN_ID=

# Shopify
SHOPIFY_STORES=www.dagnedover.com=Dagne Dover,www.herschel.com=Herschel Supply Co.,www.cuyana.com=Cuyana
UCP_AGENT_PROFILE_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public endpoint protection (see README "Public endpoints")
RATE_LIMIT_PER_MINUTE=30
MODEL_CALLS_PER_DAY=0
AGENT_WALLETS_MAX=100
TRUST_PROXY=false
